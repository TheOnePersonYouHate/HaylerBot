# --- Discord ---
# Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Enable Developer Mode in Discord (Settings -> Advanced), then
# right-click your server icon -> Copy Server ID
GUILD_ID=
# Right-click the RP channel -> Copy Channel ID
RP_CHANNEL_ID=

# --- Local LLM (LM Studio's OpenAI-compatible server) ---
# Start it in LM Studio (Developer tab -> Start Server) or:  lms server start
# Load a model in LM Studio or:  lms load google/gemma-4-31b
# Use 127.0.0.1 (not localhost) to avoid Windows IPv6 resolution delays.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=google/gemma-4-31b
# LM Studio ignores the key; the OpenAI client just needs a non-empty value.
LLM_API_KEY=lm-studio

# --- Cloud fallback (xAI / Grok) -- optional ---
# If LM Studio isn't running, the bot uses xAI instead so the crew stays online.
# Get a key at https://console.x.ai  (leave blank to disable the fallback).
# Set XAI_MODEL to a model your account supports (see https://docs.x.ai).
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3
# How many replies run on the local GPU at once before extras overflow to xAI.
# Match LM Studio's parallel slots (default 4). Needs XAI_API_KEY. 0 disables it.
LOCAL_MAX_INFLIGHT=4

# --- Persistence ---
STATE_FILE=ship_state.json
